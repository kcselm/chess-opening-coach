# Path to the native Stockfish binary. On Windows, e.g. ./engine/stockfish.exe
STOCKFISH_PATH=./engine/stockfish.exe
# SQLite (libSQL) database file
DATABASE_URL=file:./data/app.db
# Engine analysis settings
ENGINE_DEPTH=18
ENGINE_MULTIPV=3
ENGINE_THREADS=4
PORT=8787
# Optional Lichess API token — only needed to raise rate limits; Lichess import works without it.
LICHESS_TOKEN=
